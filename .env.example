# Copy to .env and fill in. Never commit .env.

# Neon / Postgres connection string.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Signing key for the admin panel session cookie.
#
# REQUIRED for /admin to work at all. Admin sign-in fails closed without it: no secret means no
# session can be signed, so nobody gets in - which is the correct behaviour for a missing key, and
# the reason there is no built-in fallback value (a fallback in the repo would let anyone who can
# read this file mint a valid admin session).
#
# Must be at least 32 characters. Generate one with:
#   openssl rand -base64 48
#
# Rotating it invalidates every existing admin session immediately.
ADMIN_SESSION_SECRET=""
