# Copy to .env and fill in. Never commit .env.

# ── SyncHQ lead capture ───────────────────────────────────────────────────────
#
# Contact submissions are posted straight into SyncHQ and become leads there. This site keeps no
# copy of them, so both values below are required for the contact form to work at all.
#
# The call is made server-side, from a server action, which is why the secret can live here: it is
# never sent to the browser and the endpoint needs no CORS allow-listing for this origin.
#
# Without these the form fails closed - the visitor is told to email us directly and the full
# submission is written to the server log, so nothing is silently lost.

# The full lead-capture endpoint, public key included. Must be https.
SYNCHQ_LEAD_URL="https://<your-app-origin>/api/public/leads/<publicKey>"

# The matching secret, sent as `Authorization: Bearer <secret>`.
# SyncHQ answers 401 for both a bad key and a bad secret, on purpose - so if submissions start
# failing with 401, check the URL as well as this.
SYNCHQ_LEAD_SECRET=""
